# ==========================================
# DevType Production Environment Variables
# ==========================================
# Copy this file to .env.local and fill in your actual Supabase credentials.

# Your Supabase Project REST URL (e.g., https://your-project-id.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Your Supabase Public Anonymous API Key
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here